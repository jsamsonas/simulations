{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "**/README.md",
      "**/placeholder.txt",
      "FIREBASE-SETUP.md"
    ],
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.@(html|py|toml|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
